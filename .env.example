DB_HOST=chat_memory_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_PORT=5432
# Local OpenAI-compatible provider. Point at a remote URL if that is your setup.
BASE_URL=http://host.docker.internal:11434/v1
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
CHAT_MODEL=granite4.1:8b
# Embedding output must be 1024 dimensions to match vector(1024) in Liquibase.
EMBEDDING_MODEL=qwen3-embedding:0.6b